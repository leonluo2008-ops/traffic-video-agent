[{"spk": 0, "start": 1240, "end": 3080, "text": "素闻太师才高八斗，"}, {"spk": 0, "start": 3220, "end": 4580, "text": "我有一个参谋将军，"}, {"spk": 0, "start": 4600, "end": 5960, "text": "想跟你切磋切磋。"}, {"spk": 1, "start": 5980, "end": 6220, "text": "哎，"}, {"spk": 1, "start": 6540, "end": 8900, "text": "我们老爷怎么可以以大欺小呢？"}, {"spk": 1, "start": 9100, "end": 9440, "text": "是啊，"}, {"spk": 2, "start": 9440, "end": 9840, "text": "是啊，"}, {"spk": 2, "start": 9860, "end": 11900, "text": "文学切磋是不分辈分的，"}, {"spk": 0, "start": 11900, "end": 13280, "text": "就是嘛玩玩而已。"}, {"spk": 0, "start": 13700, "end": 15620, "text": "不过如果你对不出来，"}, {"spk": 0, "start": 15720, "end": 16860, "text": "别怪我发飙啊。"}, {"spk": 0, "start": 18080, "end": 18280, "text": "嗯，"}, {"spk": 2, "start": 18280, "end": 21040, "text": "出队一乡二里共三夫义，"}, {"spk": 2, "start": 21040, "end": 22360, "text": "不是四书五经，"}, {"spk": 2, "start": 22360, "end": 24640, "text": "六艺进是七七八九子，"}, {"spk": 2, "start": 24760, "end": 26380, "text": "十分大胆。"}, {"spk": 0, "start": 26380, "end": 26620, "text": "对，"}, {"spk": 0, "start": 27080, "end": 27860, "text": "怎么不对呢？"}, {"spk": 0, "start": 27860, "end": 28740, "text": "你不给我面子，"}, {"spk": 0, "start": 28740, "end": 30160, "text": "我可真的要发飙了啊，"}, {"spk": 1, "start": 30160, "end": 31160, "text": "让我来试试。"}, {"spk": 1, "start": 32060, "end": 33980, "text": "十四酒瓶凑得八两，"}, {"spk": 1, "start": 34080, "end": 34520, "text": "七钱，"}, {"spk": 1, "start": 34620, "end": 36380, "text": "六分五毫四厘，"}, {"spk": 1, "start": 36480, "end": 37860, "text": "尚且三心二意，"}, {"spk": 1, "start": 38060, "end": 40520, "text": "一等下流哦，"}, {"spk": 2, "start": 40820, "end": 42020, "text": "好工整啊，"}, {"spk": 1, "start": 42880, "end": 45280, "text": "在下下来的政经之号啊，"}, {"spk": 1, "start": 45380, "end": 47380, "text": "没事没事没事嗯。"}, {"spk": 2, "start": 49100, "end": 51560, "text": "在下是七省文状元兼参谋将军，"}, {"spk": 2, "start": 51820, "end": 53740, "text": "来是对王之王的对穿肠。"}, {"spk": 2, "start": 53740, "end": 59050, "text": "阁下是小弟读过两年书城，"}, {"spk": 1, "start": 59210, "end": 62545, "text": "市中一个迷途小书童华安好我就。"}, {"spk": 1, "start": 63100, "end": 63655, "text": "来，"}, {"spk": 2, "start": 64540, "end": 65400, "text": "会一会你对不起我，"}, {"spk": 1, "start": 65400, "end": 97970, "text": "俩惺惺相惜情，"}, {"spk": 1, "start": 98010, "end": 98830, "text": "不自禁对对言，"}, {"spk": 1, "start": 99010, "end": 100005, "text": "归正传我。"}, {"spk": 1, "start": 100460, "end": 100840, "text": "们开，"}, {"spk": 2, "start": 103020, "end": 103860, "text": "始了图画里，"}, {"spk": 2, "start": 103920, "end": 109410, "text": "龙不吟虎不啸小小书童可笑可笑棋，"}, {"spk": 2, "start": 109630, "end": 111825, "text": "盘里车无轮马无疆。"}, {"spk": 1, "start": 112250, "end": 113590, "text": "叫声将军提防，"}, {"spk": 1, "start": 113650, "end": 114370, "text": "提防哦二，"}, {"spk": 1, "start": 114650, "end": 116755, "text": "号莺莺燕燕翠翠红红处。"}, {"spk": 2, "start": 117020, "end": 121800, "text": "处融融恰恰郁郁风风花，"}, {"spk": 2, "start": 121820, "end": 122740, "text": "花叶叶年，"}, {"spk": 1, "start": 122740, "end": 127440, "text": "年暮暮朝朝快出对子对，"}, {"spk": 1, "start": 127440, "end": 133400, "text": "死他对死他十口心思四，"}, {"spk": 2, "start": 133400, "end": 135920, "text": "君思国思社稷八目共赏。"}, {"spk": 2, "start": 135920, "end": 138020, "text": "赏口赏月赏秋他对死，"}, {"spk": 1, "start": 138820, "end": 142160, "text": "他我上等威风显现一。"}, {"spk": 0, "start": 142240, "end": 143280, "text": "身虎胆你，"}, {"spk": 2, "start": 145360, "end": 146440, "text": "下流剑哥露，"}, {"spk": 2, "start": 146500, "end": 147760, "text": "出半个龟头啊，"}, {"spk": 1, "start": 148000, "end": 151440, "text": "我堂堂参谋将军会输给你个，"}, {"spk": 2, "start": 152780, "end": 155420, "text": "书头你家坟头来种树奴家澡盆砸，"}, {"spk": 2, "start": 156160, "end": 157800, "text": "我鱼鱼飞过愁入，"}, {"spk": 1, "start": 158180, "end": 159960, "text": "我肚你老娘来清，"}, {"spk": 2, "start": 160700, "end": 161320, "text": "下厨看对，"}, {"spk": 2, "start": 161320, "end": 162220, "text": "对儿本为，"}, {"spk": 1, "start": 162540, "end": 171940, "text": "消遣作乐今日穿堂兄居然对道熬出几十。"}, {"spk": 1, "start": 171940, "end": 174380, "text": "两血可谓空前绝后小弟佩不配晚安，"}, {"spk": 1, "start": 174440, "end": 175560, "text": "哪没你的事儿了。"}, {"spk": 1, "start": 175580, "end": 179400, "text": "哎你出，"}, {"spk": 1, "start": 179400, "end": 180940, "text": "。"}, {"spk": 1, "start": 180980, "end": 181200, "text": "，"}, {"spk": 1, "start": 181200, "end": 181590, "text": "。"}]