[
 {
  "start": 0.88,
  "end": 5.88,
  "text": "素文太师才高八斗,我有一个参谋将军想跟你切磋切磋。"
 },
 {
  "start": 5.88,
  "end": 8.88,
  "text": "我们老爷怎么可以以大欺小呢?"
 },
 {
  "start": 8.88,
  "end": 11.88,
  "text": "是啊是啊,文学切磋是不分辈分的。"
 },
 {
  "start": 11.88,
  "end": 16.88,
  "text": "就是嘛,玩玩而已。不过,如果你对不出来,别怪我发飙啊。"
 },
 {
  "start": 18.07,
  "end": 19.07,
  "text": "出队!"
 },
 {
  "start": 19.07,
  "end": 26.07,
  "text": "一箱二礼,共三夫子,不是四书五经六义,竟敢教七八九子,十分大胆。"
 },
 {
  "start": 26.07,
  "end": 30.07,
  "text": "对啊,怎么不对呢?你不给我面子,我可真的要发飙了。"
 },
 {
  "start": 30.07,
  "end": 39.23,
  "text": "让我来试试。十四九平,凑的八两,七千六分,五毫四厘,上千三星二亿,一等下流。"
 },
 {
  "start": 40.68,
  "end": 41.68,
  "text": "好工整啊。"
 },
 {
  "start": 42.68,
  "end": 44.68,
  "text": "华安,你来的正是时候啊。"
 },
 {
  "start": 44.68,
  "end": 46.68,
  "text": "没事没事没事。"
 },
 {
  "start": 47.68,
  "end": 53.64,
  "text": "在下是七省文状元兼参谋将军,绰号对王之王的对川长。"
 },
 {
  "start": 53.64,
  "end": 54.64,
  "text": "阁下是……"
 },
 {
  "start": 57.4,
  "end": 62.4,
  "text": "小弟读过两年书,陈氏中一个迷途小书童,华安。"
 },
 {
  "start": 62.4,
  "end": 63.4,
  "text": "好。"
 },
 {
  "start": 63.4,
  "end": 65.75,
  "text": "我就来会一会你。"
 },
 {
  "start": 65.75,
  "end": 100.02,
  "text": "我俩惺惺相惜,情不自禁。"
 },
 {
  "start": 101.02,
  "end": 104.49,
  "text": "眼归正传,我们开始了。"
 },
 {
  "start": 104.49,
  "end": 111.63,
  "text": "童话里,龙不吟,虎不笑,笑笑书童,可笑可笑。"
 },
 {
  "start": 111.63,
  "end": 116.63,
  "text": "棋盘里,车不轮,马无将,叫声将军,提防提防哦。"
 },
 {
  "start": 116.63,
  "end": 117.63,
  "text": "好!"
 },
 {
  "start": 119.66,
  "end": 122.66,
  "text": "莺莺燕燕,翠翠红红,处处,融融恰恰。"
 },
 {
  "start": 122.66,
  "end": 128.9,
  "text": "玉峰峰,华华,燕燕,年年暮暮,昭昭。"
 },
 {
  "start": 128.9,
  "end": 129.99,
  "text": "啊。"
 },
 {
  "start": 129.99,
  "end": 131.99,
  "text": "哈哈,真行啊。"
 },
 {
  "start": 131.99,
  "end": 134.22,
  "text": "快出对子对死她!对死她!"
 },
 {
  "start": 134.22,
  "end": 138.22,
  "text": "十口心似,四军四国,似设计,八目共赏。"
 },
 {
  "start": 138.22,
  "end": 141.22,
  "text": "赏花赏月赏秋香。"
 },
 {
  "start": 141.22,
  "end": 143.22,
  "text": "好啊!好啊!"
 },
 {
  "start": 143.22,
  "end": 148.22,
  "text": "我尚等魏玉峰陷陷一身胡胆。"
 },
 {
  "start": 148.22,
  "end": 151.22,
  "text": "你下流剑格,露出半个龟头。"
 },
 {
  "start": 151.22,
  "end": 155.22,
  "text": "我堂堂参谋将军,会输给你的书童。"
 },
 {
  "start": 155.22,
  "end": 158.22,
  "text": "你家坟头来中书。"
 },
 {
  "start": 158.22,
  "end": 160.26,
  "text": "奴家灶盆杂配鱼"
 },
 {
  "start": 160.74,
  "end": 162.46,
  "text": "鱼飞过船入我洞"
 },
 {
  "start": 162.66,
  "end": 164.66,
  "text": "你老娘来倾下厨"
 },
 {
  "start": 170.48,
  "end": 171.96,
  "text": "对对本为消遣作乐"
 },
 {
  "start": 171.96,
  "end": 174.44,
  "text": "今日川藏兄居然对得熬出几十两血"
 },
 {
  "start": 174.44,
  "end": 175.64,
  "text": "可谓空前绝后"
 },
 {
  "start": 175.64,
  "end": 177.04,
  "text": "小弟佩服佩服"
 },
 {
  "start": 179.22,
  "end": 179.9,
  "text": "华安哪"
 },
 {
  "start": 179.9,
  "end": 181.02,
  "text": "这儿没你的事了"
 },
 {
  "start": 181.26,
  "end": 181.74,
  "text": "你出"
 }
]